{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist", "!src/shared/components/ui", "!public/"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"nursery": {
				"recommended": true,
				"useSortedClasses": "error"
			},
			"suspicious": {
				"noReactSpecificProps": "off",
				"noEmptySource": {
					"level": "on",
					"options": {
						"allowComments": true
					}
				}
			},
			"correctness": {
				"useImportExtensions": "off",
				"useQwikValidLexicalScope": "off",
				"noSolidDestructuredProps": "off"
			},
			"performance": {
				"noImgElement": "off",
				"useSolidForComponent": "off"
			},
			"style": {
				"noJsxLiterals": "off",
				"noContinue": "off",
				"noTernary": "off",
				"noNestedTernary": "off",
				"noIncrementDecrement": "off",
				"noEnum": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},

	"overrides": [
		{
			"includes": ["src/features/entry-point/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/features/freelancers-cut/**"],
										"message": "Entry Point may not import from Freelancer's Cut"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/features/freelancers-cut/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/features/entry-point/**"],
										"message": "Freelancer's Cut may not import from Entry Point"
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
